# Copy to .env and fill in. Never commit .env.

# Postgres + pgvector (local compose default shown; a Neon connection string also works)
DATABASE_URL=postgresql://regcomp:regcomp_local_only@localhost:5432/regcomp

# Local open-weights models via Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Hosted open-weights provider for the strong (escalation) model; name the key per provider
STRONG_MODEL_API_KEY=


# Guard (PROBLEMS_LOG P-058, fail-closed since 7 Oct): label the databases (no credentials).
# Every process prints which database it uses. Live is read-only unless REGCOMP_ALLOW_LIVE=1 for
# one approved command; any remote host with no label is read-only unless
# REGCOMP_ALLOW_UNLABELLED=1; localhost (the compose database) and d2 are writable.
# REGCOMP_LIVE_HOST matches Neon's "-pooler" host too; REGCOMP_LIVE_DB (optional) also treats
# any other remote host with that database name as live.
REGCOMP_LIVE_HOST=
REGCOMP_D2_HOST=
REGCOMP_LIVE_DB=
