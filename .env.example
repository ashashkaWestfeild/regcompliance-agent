# Copy to .env and fill in. Never commit .env.

# Postgres + pgvector (local compose default shown; a Neon connection string also works)
DATABASE_URL=postgresql://regcomp:regcomp_local_only@localhost:5432/regcomp

# Local open-weights models via Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Hosted open-weights provider for the strong (escalation) model; name the key per provider
STRONG_MODEL_API_KEY=

# MLflow tracking (local server)
MLFLOW_TRACKING_URI=http://localhost:5000

# Guard (PROBLEMS_LOG P-058): label the databases by host name (no credentials). Scripts print
# which database they use; the live host is read-only unless REGCOMP_ALLOW_LIVE=1 is set for one
# approved command. Leave unset in the hosted app.
REGCOMP_LIVE_HOST=
REGCOMP_D2_HOST=
